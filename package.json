{
  "name": "iot-medication-reminder-box",
  "version": "1.0.0",
  "description": "IoT Medication Reminder Box System via Web Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "pm2 start ecosystem.config.js --env production",
    "prod:restart": "pm2 restart ecosystem.config.js",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:logs": "pm2 logs medbox-prod"
  },
  "keywords": [
    "iot",
    "esp32",
    "medication-reminder",
    "express",
    "mariadb",
    "bootstrap"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pm2": "^7.0.3"
  }
}
